{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "es6",
      "dom"
    ],
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitAny": true
  },
  "include": ["src"]
}
